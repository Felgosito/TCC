{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*.js" },
    { "source": "/sobre",     "destination": "/sobre.html" },
    { "source": "/unidades", "destination": "/unidades.html" },
    { "source": "/",         "destination": "/index.html" }
  ]
}
